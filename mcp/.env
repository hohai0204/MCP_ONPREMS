# ---------------------------------------------------------------------------
# BASE / SHARED settings for all SAP systems.
# Per-system credentials live in profiles/<name>.env (e.g. profiles/s4d-360.env),
# which OVERRIDE anything here. Put only policy shared across systems below.
# ---------------------------------------------------------------------------

# Sensitive-table read blocklist (comma-separated, * wildcards). Unset = the
# built-in default (USR02, PA0*, SECSTORE*, ...).
# SAP_TABLE_BLOCKLIST=USR02,PA0*,SECSTORE*

# Deny list for sap_run_rfc (comma-separated, * wildcards). Unset = built-in
# default (OS exec, arbitrary ABAP, mass delete, raw SQL, user admin, ...).
# SAP_FM_DENYLIST=RFC_ABAP_INSTALL_AND_RUN,SXPG_*,DB_*,TH_*

# NOTE: no SAP_USER / SAP_PASSWD / SAP_ASHOST here — those belong in a profile
# under profiles/. The S4D system is configured in profiles/s4d-360.env.
