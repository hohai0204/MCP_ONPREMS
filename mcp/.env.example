# ---------------------------------------------------------------------------
# SAP RFC connection settings for the MCP bridge.
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Logon ---
SAP_USER=YOUR_RFC_USER
SAP_PASSWD=YOUR_PASSWORD
SAP_CLIENT=100
SAP_LANG=EN

# --- Direct application-server connection ---
# For a SAProuter, either put the full route string in SAP_ASHOST, e.g.
#   SAP_ASHOST=/H/saprouter.example.com/S/3299/H/sapappserver.internal
# ...or leave SAP_ASHOST as the plain host and set SAP_SAPROUTER below (it is
# prepended automatically).
SAP_ASHOST=sapappserver.internal
SAP_SYSNR=00

# SAProuter route prefix (optional). Example: /H/saprouter.example.com/S/3299
# Leave empty if SAP_ASHOST already contains the full /H/.../S/... route.
SAP_SAPROUTER=

# --- Message-server / load-balanced logon (optional; alternative to ASHOST) ---
# SAP_MSHOST=
# SAP_MSSERV=
# SAP_SYSID=
# SAP_GROUP=PUBLIC

# --- SNC secure connection (optional) ---
# SAP_SNC_QOP=9
# SAP_SNC_PARTNERNAME=p:CN=...
# SAP_SNC_LIB=

# --- Safety switch ---
# Write/modify tools (create/update ABAP source, activate) are DISABLED unless
# this is exactly "true". Keep it false for read-only exploration.
SAP_ALLOW_WRITE=false

# Sensitive-table read policy: comma-separated table patterns (with * wildcards)
# that sap_read_table refuses to read. Leave unset for the built-in default
# (USR02, USH02, PA0*, PB0*, HRP*, SECSTORE*, ...). Setting this REPLACES the
# default list entirely.
# SAP_TABLE_BLOCKLIST=USR02,PA0*,SECSTORE*

# Package whitelist for write tools (comma-separated, * wildcards). When set,
# sap_write_program may only touch programs in these packages (new programs
# are created in $TMP, so include $TMP to allow creation). Unset = any package.
# SAP_ALLOWED_PACKAGES=$TMP,ZPK_SANDBOX*

# Deny list for sap_run_rfc (comma-separated, * wildcards). High-risk function
# modules that sap_run_rfc refuses to call even when SAP_ALLOW_WRITE=true.
# Setting this REPLACES the built-in default (OS exec, arbitrary ABAP, mass
# delete, raw SQL, user admin, file transfer, kernel admin).
# SAP_FM_DENYLIST=RFC_ABAP_INSTALL_AND_RUN,SXPG_*,DB_*,TH_*

# Optional path to SAP NW RFC SDK if not on PATH / SAPNWRFC_HOME
# SAPNWRFC_HOME=C:\nwrfcsdk
