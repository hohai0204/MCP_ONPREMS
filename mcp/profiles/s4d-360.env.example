# ---------------------------------------------------------------------------
# Per-system profile. Copy to "<system>.env" (e.g. s4d-360.env, qa4.env, prd.env).
# setup.ps1 registers one MCP server "sap-<name>" per profile file here.
# Values here OVERRIDE the shared base .env. Put per-system logon here; keep
# common policy (SAP_TABLE_BLOCKLIST, SAP_FM_DENYLIST, ...) in the base .env.
# ---------------------------------------------------------------------------

SAP_USER=YOUR_RFC_USER
SAP_PASSWD=YOUR_PASSWORD
SAP_CLIENT=100
SAP_LANG=EN

SAP_ASHOST=sapappserver.internal
SAP_SYSNR=00
SAP_SAPROUTER=/H/saprouter.example.com/S/3299

# Per-system write switch — keep DEV writable, QA/PRD read-only.
SAP_ALLOW_WRITE=false
# SAP_ALLOWED_PACKAGES=$TMP,ZPK_SANDBOX*
