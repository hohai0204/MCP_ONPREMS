            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/PoHeaderSet?sap-client={{client}}&$format=json"
            },
            "description": ""
          }
        },
        {
          "name": "Phân trang ($top/$skip)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/PoHeaderSet?sap-client={{client}}&$format=json&$top=20&$skip=20"
